# Find Your Crew uses the existing LikeMinds Supabase project.
# Copy values from Supabase Dashboard → Project → Connect.
# Set both variables for Preview and Production in Vercel → Settings → Environment Variables.
# The publishable key is safe in the browser; NEVER use a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Legacy projects can use NEXT_PUBLIC_SUPABASE_ANON_KEY instead of the publishable key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_legacy_anon_key
