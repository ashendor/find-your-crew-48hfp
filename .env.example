# Dedicated Find Your Crew Supabase project (not LikeMinds)
NEXT_PUBLIC_SUPABASE_URL=https://gtytlzylsohpeuewqjuw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=copy_publishable_key_from_new_project
# Legacy fallback if needed: NEXT_PUBLIC_SUPABASE_ANON_KEY=...

# Public origin only. Do not include /48hrproject; Next.js basePath adds it.
# Production Google sign-in returns to ${NEXT_PUBLIC_SITE_URL}/48hrproject/profile.
NEXT_PUBLIC_SITE_URL=https://likeminds.ae

# Enable only after Google OAuth credentials are configured in Supabase Auth.
# Google client secrets must NEVER be stored in this file or a NEXT_PUBLIC variable.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false
